    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "^3.0.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@panva/hkdf": "^1.2.1",
    "@peculiar/x509": "^2.1.0",
